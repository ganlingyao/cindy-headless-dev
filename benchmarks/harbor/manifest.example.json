{
  "schemaVersion": 1,
  "board": "same-model-harness",
  "dataset": {
    "name": "terminal-bench",
    "revision": "2.0",
    "taskIds": ["replace-with-five-or-more-frozen-task-ids"]
  },
  "modelIds": ["claude-sonnet-4-6"],
  "repetitions": 1,
  "variants": [
    { "id": "cindy-production-claude", "supportedModelIds": ["claude-sonnet-4-6"] },
    { "id": "cindy-no-compaction", "supportedModelIds": ["claude-sonnet-4-6"] }
  ],
  "seed": 127,
  "concurrency": 1,
  "agentOrder": ["cindy-production-claude", "cindy-no-compaction"],
  "runtime": {
    "timeoutMs": 900000,
    "cpu": 2,
    "memoryMb": 4096,
    "network": "benchmark-default",
    "permissions": "benchmark-default"
  },
  "retry": { "agent": 0, "infra": 1 },
  "budget": { "maxCostUsd": 25, "stopAfterFailures": 5 },
  "throughputCap": { "enabled": false, "outputTokensPerSecond": 35 }
}
