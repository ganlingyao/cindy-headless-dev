    "features": {
      "projectContext": {
        "type": "boolean",
        "control": "profile",
        "default": false,
        "label": "Project Context",
        "description": "Inject the current project context"
      },
      "makerMemory": {
        "type": "boolean",
        "control": "profile",
        "default": false,
        "label": "Maker Memory",
        "description": "Use Cindy Maker Memory"
      },
      "nativeMemory": {
        "type": "boolean",
        "control": "profile",
        "default": false,
        "label": "Native Memory",
        "description": "Use the harness native memory"
      },
      "compaction": {
        "type": "object",
        "control": "profile",
        "default": {
          "enabled": true,
          "thresholdPct": 80
        },
        "label": "Compaction",
        "description": "Context compaction configuration"
      },
      "attachments": {
        "type": "boolean",
        "control": "profile",
        "default": false,
        "label": "Attachments",
