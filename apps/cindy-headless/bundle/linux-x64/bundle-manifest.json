      },
      {
        "id": "cindy-pi",
        "features": [
          "projectContext",
          "makerMemory",
          "nativeMemory",
          "attachments",
          "piProjectSkills"
        ],
        "supportedModelIds": [
          "claude-sonnet-4-6"
        ],
        "defaultModel": {
          "provider": "cindy",
          "requestedId": "claude-sonnet-4-6",
          "contextLimit": 200000,
          "maxOutputTokens": 32000,
          "effort": "high"
        },
        "backend": "pi",
        "adapterSupported": true
      }
    ],
    "features": {
      "projectContext": {
        "type": "boolean",
        "control": "profile",
        "default": false,
        "label": "Project Context",
        "description": "Inject the current project context"
      },
      "makerMemory": {
        "type": "boolean",
        "control": "profile",
        "default": false,
        "label": "Maker Memory",
        "description": "Use Cindy workdir-scoped memory shared across harnesses"
      },
      "nativeMemory": {
        "type": "boolean",
        "control": "profile",
        "default": false,
        "label": "Native Memory",
        "description": "Use Claude Auto Memory, Codex experimental memories, or Pi Auto Memory"
      },
      "attachments": {
        "type": "boolean",
        "control": "profile",
        "default": false,
        "label": "Attachments",
        "description": "Allow attachment input"
      },
      "piProjectSkills": {
        "type": "boolean",
        "control": "profile",
        "default": false,
        "label": "Pi Project Skills",
        "description": "Allow Pi to load project skills"
      }
    },
    "controls": {
      "permissionMode": {
        "type": "enum",
        "control": "profile",
        "default": "bypassPermissions",
        "values": [
          "bypassPermissions",
          "acceptEdits",
          "default",
          "ask",
          "auto",
          "plan"
        ]
      },
      "remoteHttpMcp": {
        "type": "array",
        "control": "profile",
        "credentialSafe": true,
        "description": "Remote HTTP MCP configuration supplied separately from feature switches"
      },
      "nativeProviders": {
        "type": "array",
        "control": "profile-route",
        "credentialSafe": true,
        "description": "Pi native provider configuration derived from the selected model route"
      },
      "toolSurface": {
        "type": "object",
        "control": "profile-harness",
        "digest": "toolSurfaceDigest"
      },
      "mcpProviders": {
        "type": "array",
        "control": "profile",
        "credentialSafe": true
      },
      "subagents": {
        "type": "object",
        "control": "profile-route",
        "properties": {
          "enabled": "boolean",
          "strategy": [
            "native",
            "disabled"
          ],
          "modelSource": [
            "same-as-parent",
            "explicit-route"
          ]
        }
      },
      "contextLimit": {
        "type": "integer",
        "control": "model-route",
        "enforcement": "client-request",
        "minimum": 1
      },
      "effort": {
        "type": "enum",
        "control": "model-route",
        "values": [
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "max",
          "ultra"
        ]
      },
      "maxOutputTokens": {
        "type": "integer",
        "control": "model-route",
        "enforcement": "client-request",
        "minimum": 1
      },
      "compatibilityProxy": {
        "type": "object",
        "control": "route-profile",
        "credentialSafe": true
      },
      "containerSandbox": {
        "type": "boolean",
        "control": "execution",
        "default": true,
        "requiredForFormalRun": true,
        "userEditable": false
      },
      "throughputCap": {
        "type": "object",
        "control": "external-proxy",
        "requiresExternalEnforcement": true,
        "requiresEvidence": true
      }
    },
    "defaultValues": {
      "projectContext": false,
      "makerMemory": false,
      "nativeMemory": false,
      "attachments": false,
      "piProjectSkills": false
    },
    "constraints": [
      {
        "type": "mutuallyExclusive",
        "features": [
          "makerMemory",
          "nativeMemory"
        ],
        "harnesses": [
          "claude-code",
          "codex"
        ],
        "offLabel": "关闭所有自动记忆"
      }
    ]
  },
