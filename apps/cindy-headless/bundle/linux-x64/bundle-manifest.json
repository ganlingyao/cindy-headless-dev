        },
        "backend": "claude-code",
        "adapterSupported": true
      },
      {
        "id": "cindy-codex",
        "features": [
          "projectContext",
          "makerMemory",
          "nativeMemory",
          "attachments"
        ],
        "supportedModelIds": [
          "gpt-5.4-mini"
        ],
        "defaultModel": {
          "provider": "openai",
