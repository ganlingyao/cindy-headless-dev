            "same-as-parent",
            "explicit-route"
          ]
        }
      },
      "contextLimit": {
        "type": "integer",
        "control": "model-route",
        "enforcement": "client-request",
        "minimum": 1
      },
      "effort": {
        "type": "enum",
        "control": "model-route",
        "values": [
          "minimal",
          "low",
          "medium",
          "high",
          "xhigh",
          "max",
          "ultra"
        ]
      },
      "maxOutputTokens": {
        "type": "integer",
        "control": "model-route",
        "enforcement": "client-request",
        "minimum": 1
      },
      "compatibilityProxy": {
        "type": "object",
        "control": "route-profile",
        "credentialSafe": true
      },
      "containerSandbox": {
        "type": "boolean",
        "control": "execution",
        "default": true,
        "requiredForFormalRun": true,
        "userEditable": false
      },
      "throughputCap": {
        "type": "object",
        "control": "external-proxy",
        "requiresExternalEnforcement": true,
        "requiresEvidence": true
      }
    },
