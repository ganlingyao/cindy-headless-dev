        "type": "array",
        "control": "profile",
        "default": [],
        "label": "Native Providers",
        "description": "Pi native model provider configuration"
      }
    },
    "controls": {
      "permissionMode": {
        "type": "enum",
        "control": "profile",
        "default": "bypassPermissions",
        "values": [
          "bypassPermissions",
          "acceptEdits",
          "default",
          "ask",
          "auto",
          "plan"
        ]
      },
      "systemPrompt": {
        "type": "enum",
        "control": "profile-bundle",
        "default": "cindy-production",
        "values": [
          "cindy-production",
          "vendor-default"
        ],
        "evidence": [
          "systemPromptDigest"
        ]
      },
      "toolSurface": {
        "type": "object",
        "control": "profile-harness",
        "digest": "toolSurfaceDigest"
      },
      "mcpProviders": {
        "type": "array",
        "control": "profile",
        "credentialSafe": true
      },
      "subagents": {
        "type": "object",
