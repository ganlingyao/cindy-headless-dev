{
  "name": "cindy-headless",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "bin": {
    "cindy-headless": "dist/cli.cjs",
    "cindy-headless-eval": "dist/eval-cli.cjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "ensure:binaries": "node scripts/ensure-agent-binaries.mjs",
    "bundle:linux": "node scripts/build-linux-bundle.mjs",
    "bundle:linux:claude": "node scripts/build-linux-claude-bundle.mjs",
    "package:runtime": "node scripts/package-release.mjs",
    "package:full": "node scripts/package-release.mjs --allow-vendor-binaries",
    "verify:distribution:full": "node scripts/verify-full-distribution.mjs",
    "test:distribution": "node scripts/verify-distribution.mjs",
    "doctor:distribution": "node scripts/distribution-doctor.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:bundle:claude": "node scripts/verify-claude-bundle.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@cindy/maker-core": "workspace:*",
    "@cindy/mcps": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
